# Server Configuration
PORT=3000

# Optional: Add AI API keys if using external services
# HUGGINGFACE_API_KEY=your_free_token_here
# OPENAI_API_KEY=your_free_token_here (if using free tier)
# AISEC_API_URL=https://your-aisec-host/api/ai/process
# AISEC_API_KEY=your_aisec_api_key
# AISEC_TIMEOUT_MS=5000

# Swireit deployment details (used to initialize AISec)
# SWIREIT_PROJECT_ID=your_swireit_project_id
# SWIREIT_API_TOKEN=your_swireit_api_token
# SWIREIT_SPACE_URL=your-space.swireit.com
# SWIREIT_CALLER_ID=+15551231234
# SWIREIT_TWIML_URL=your_swireit_twiml_url
# SWIREIT_VALIDATE_WEBHOOKS=true

# Optional: Enable production mode
# NODE_ENV=production
